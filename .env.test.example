# copy to .env.test (chmod 600) and fill in; used by scripts/test-local.sh
# on macOS, prefer the keychain instead - see scripts/test-local.sh
# any token with read access to the public sample repositories works

# https://github.com/eeditiones/tuttle-sample-data
# optional: falls back to `gh auth token`
tuttle_token_tuttle_sample_data=

# https://gitlab.com/line-o/tuttle-sample-data (needs read_api scope)
tuttle_token_tuttle_sample_gitlab=
